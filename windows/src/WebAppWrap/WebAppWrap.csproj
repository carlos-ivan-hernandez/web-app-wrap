<Project Sdk="Microsoft.NET.Sdk">
  <!-- One program, two roles: with no arguments it's the Web App Wrap window that creates apps;
       launched by a wrapped app's Start menu shortcut it's that wrapped app's browser window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WebAppWrap</RootNamespace>
    <AssemblyName>WebAppWrap</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: no MSIX, no separate Windows App SDK runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The UI is built in C#, and Program.Main starts the app. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <!-- scripts/build.ps1 draws this with the same renderer used for wrapped apps. -->
  <PropertyGroup Condition="Exists('Assets\AppIcon.ico')">
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" Condition="Exists('Assets\AppIcon.ico')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WebAppWrap.Core\WebAppWrap.Core.csproj" />
  </ItemGroup>
</Project>
