<Project Sdk="Microsoft.NET.Sdk">
  <!-- waw.exe: the command-line version of Web App Wrap. Installed next to WebAppWrap.exe,
       which every wrapped app runs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>waw</AssemblyName>
    <RootNamespace>WebAppWrap.Cli</RootNamespace>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WebAppWrap.Core\WebAppWrap.Core.csproj" />
  </ItemGroup>
</Project>
